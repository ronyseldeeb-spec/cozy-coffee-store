<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cozy Brews & Bakery</title>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,600;1,400&display=swap" rel="stylesheet">
    <!-- EmailJS SDK -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <style>
        :root {
            --bg-color: #FAF6F0;
            --card-bg: #FFFFFF;
            --primary-dark: #2C1810;
            --accent-warm: #C87D55;
            --accent-gold: #D4A373;
            --text-main: #3D2314;
            --text-muted: #7A685D;
            --shadow-soft: 0 10px 30px rgba(44, 24, 16, 0.06);
            --shadow-hover: 0 15px 35px rgba(44, 24, 16, 0.12);
            --radius-lg: 20px;
            --radius-sm: 10px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Outfit', sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            line-height: 1.6;
            overflow-x: hidden;
        }

        /* --- Animations --- */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @keyframes pulseGlow {
            0% { box-shadow: 0 0 0 0 rgba(200, 125, 85, 0.4); }
            70% { box-shadow: 0 0 0 15px rgba(200, 125, 85, 0); }
            100% { box-shadow: 0 0 0 0 rgba(200, 125, 85, 0); }
        }

        .animated-fade {
            animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* --- Header / Navigation --- */
        header {
            background: rgba(250, 246, 240, 0.95);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 100;
            border-bottom: 1px solid rgba(212, 163, 115, 0.2);
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--primary-dark);
            cursor: pointer;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .order-counter-badge {
            background: #E8D8C8;
            color: var(--primary-dark);
            padding: 0.4rem 0.9rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            border: 1px solid var(--accent-gold);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .user-btn {
            background: transparent;
            border: 1px solid var(--primary-dark);
            color: var(--primary-dark);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.88rem;
            transition: all 0.2s;
        }

        .user-btn:hover {
            background: var(--primary-dark);
            color: #fff;
        }

        .cart-btn {
            background: var(--primary-dark);
            color: #fff;
            padding: 0.6rem 1.4rem;
            border-radius: 30px;
            cursor: pointer;
            border: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s, background 0.3s;
        }

        .cart-btn:hover {
            background: var(--accent-warm);
            transform: scale(1.03);
        }

        /* --- Hero Section --- */
        .hero {
            padding: 3.5rem 8% 2rem;
            text-align: center;
            background: linear-gradient(180deg, rgba(212, 163, 115, 0.15) 0%, rgba(250, 246, 240, 0) 100%);
        }

        .hero h1 {
            font-family: 'Playfair Display', serif;
            font-size: 3.2rem;
            color: var(--primary-dark);
            margin-bottom: 0.8rem;
        }

        .hero p {
            font-size: 1.15rem;
            color: var(--text-muted);
            max-width: 650px;
            margin: 0 auto 1.5rem;
        }

        /* --- Category Filter Navigation --- */
        .categories {
            display: flex;
            justify-content: center;
            gap: 0.8rem;
            margin-bottom: 3rem;
            flex-wrap: wrap;
        }

        .cat-btn {
            background: transparent;
            border: 2px solid var(--accent-gold);
            padding: 0.6rem 1.4rem;
            border-radius: 25px;
            color: var(--text-main);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .cat-btn.active, .cat-btn:hover {
            background: var(--accent-gold);
            color: #fff;
        }

        /* --- Main Content Views --- */
        .page-view {
            display: none;
        }

        .page-view.active {
            display: block;
        }

        .container {
            padding: 0 8% 4rem;
        }

        .section-header {
            margin: 2.5rem 0 1.5rem;
            border-bottom: 2px solid rgba(212, 163, 115, 0.2);
            padding-bottom: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--primary-dark);
        }

        /* --- Product Cards --- */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
            gap: 2rem;
        }

        .product-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 1.2rem;
            box-shadow: var(--shadow-soft);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-hover);
        }

        .image-container {
            width: 100%;
            height: 190px;
            border-radius: var(--radius-sm);
            overflow: hidden;
            position: relative;
            background: #f4eee8;
        }

        .product-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge-can {
            position: absolute;
            top: 10px;
            left: 10px;
            background: var(--primary-dark);
            color: #fff;
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 12px;
            text-transform: uppercase;
        }

        .product-info {
            margin-top: 1rem;
        }

        .product-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.2rem;
            color: var(--primary-dark);
            margin-bottom: 0.3rem;
        }

        .product-desc {
            font-size: 0.88rem;
            color: var(--text-muted);
            margin-bottom: 1rem;
        }

        .product-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .price {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--accent-warm);
        }

        .add-btn {
            background: var(--bg-color);
            border: 1px solid var(--accent-warm);
            color: var(--accent-warm);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .add-btn:hover {
            background: var(--accent-warm);
            color: #fff;
        }

        /* --- Dedicated Checkout Page View --- */
        .checkout-page-container {
            max-width: 850px;
            margin: 3rem auto 5rem;
            padding: 0 5%;
        }

        .checkout-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            padding: 3rem;
            box-shadow: var(--shadow-soft);
            border: 1px solid rgba(212, 163, 115, 0.3);
        }

        .back-to-store-btn {
            background: transparent;
            border: none;
            color: var(--accent-warm);
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 1.5rem;
            font-size: 1rem;
        }

        .checkout-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            color: var(--primary-dark);
            margin-bottom: 0.5rem;
        }

        .cart-items-table {
            width: 100%;
            border-collapse: collapse;
            margin: 1.5rem 0;
        }

        .cart-items-table th, .cart-items-table td {
            padding: 0.8rem;
            text-align: left;
            border-bottom: 1px solid #E0D6CD;
        }

        .cart-items-table th {
            color: var(--text-muted);
            font-weight: 600;
        }

        .qty-controls {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .qty-btn {
            background: var(--bg-color);
            border: 1px solid var(--accent-gold);
            width: 25px;
            height: 25px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: 700;
            line-height: 1;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
            margin-top: 1.5rem;
        }

        @media (max-width: 650px) {
            .form-grid { grid-template-columns: 1fr; }
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        @media (max-width: 650px) {
            .form-group.full-width { grid-column: span 1; }
        }

        .form-group label {
            display: block;
            font-weight: 600;
            margin-bottom: 0.4rem;
            color: var(--text-main);
            font-size: 0.9rem;
        }

        .form-group input, .form-group textarea {
            width: 100%;
            padding: 0.85rem;
            border: 1px solid #E0D6CD;
            border-radius: var(--radius-sm);
            background: #FAF8F5;
            font-size: 0.95rem;
            outline: none;
            transition: border 0.3s;
        }

        .form-group input:focus, .form-group textarea:focus {
            border-color: var(--accent-warm);
        }

        .submit-btn {
            width: 100%;
            background: var(--accent-warm);
            color: white;
            border: none;
            padding: 1.1rem;
            border-radius: 30px;
            font-weight: 700;
            font-size: 1.1rem;
            cursor: pointer;
            transition: background 0.3s;
            animation: pulseGlow 2s infinite;
            margin-top: 1rem;
        }

        .submit-btn:hover {
            background: var(--primary-dark);
        }

        /* --- Toast Notification --- */
        .toast {
            position: fixed;
            bottom: 30px;
            right: 30px;
            background: var(--primary-dark);
            color: #fff;
            padding: 1rem 1.8rem;
            border-radius: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 1000;
            transform: translateY(150%);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .toast.show {
            transform: translateY(0);
        }

        /* --- Delivery Success Banner --- */
        .delivery-banner {
            display: none;
            background: linear-gradient(135deg, #2C1810, #3D2314);
            color: #FAF6F0;
            padding: 3rem 2rem;
            border-radius: var(--radius-lg);
            text-align: center;
            box-shadow: var(--shadow-hover);
            margin: 3rem auto;
            max-width: 700px;
            animation: fadeIn 0.8s ease forwards;
        }

        .delivery-banner h2 {
            font-family: 'Playfair Display', serif;
            color: var(--accent-gold);
            font-size: 2.2rem;
            margin-bottom: 0.5rem;
        }

        .timer-badge {
            display: inline-block;
            background: var(--accent-warm);
            color: white;
            padding: 0.7rem 2rem;
            border-radius: 25px;
            font-weight: 700;
            margin-top: 1.5rem;
            font-size: 1.15rem;
        }

        .order-again-btn {
            background: transparent;
            border: 2px solid var(--accent-gold);
            color: var(--bg-color);
            padding: 0.8rem 1.8rem;
            border-radius: 30px;
            font-weight: 700;
            margin-top: 1.5rem;
            cursor: pointer;
            transition: all 0.3s;
            display: inline-block;
        }

        .order-again-btn:hover {
            background: var(--accent-gold);
            color: var(--primary-dark);
        }

        /* --- Modal Backdrop & Box --- */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }

        .modal-card {
            background: var(--card-bg);
            padding: 2.5rem;
            border-radius: var(--radius-lg);
            width: 90%;
            max-width: 450px;
            box-shadow: var(--shadow-hover);
            position: relative;
        }

        .modal-close {
            position: absolute;
            top: 15px; right: 20px;
            background: none; border: none;
            font-size: 1.5rem; cursor: pointer; color: var(--text-muted);
        }
    </style>
</head>
<body>

    <!-- Header Navigation -->
    <header class="animated-fade">
        <div class="logo" onclick="switchPage('store')">
            ☕ Cozy Brews
        </div>

        <div class="header-actions">
            <div class="order-counter-badge">
                📊 Store Orders: <span id="store-orders-count">0</span>
            </div>

            <button class="user-btn" id="user-profile-btn" onclick="openAuthModal()">
                👤 Sign In
            </button>

            <button class="cart-btn" onclick="switchPage('checkout')">
                🛒 Cart (<span id="cart-count">0</span>)
            </button>
        </div>
    </header>

    <!-- STORE PAGE VIEW -->
    <div id="store-page" class="page-view active animated-fade">
        <section class="hero">
            <h1>Handcrafted Coffee & Fresh Bakery</h1>
            <p>Discover our specialty espresso drinks, signature canned cold brews, freshly baked croissants, gourmet savory sandwiches, and handcrafted desserts.</p>
        </section>

        <section class="container">
            <div class="categories">
                <button class="cat-btn active" onclick="filterCategory('all')">All Menu</button>
                <button class="cat-btn" onclick="filterCategory('hot')">Hot Coffee & Drinks</button>
                <button class="cat-btn" onclick="filterCategory('cold')">Cold Drinks (Canned)</button>
                <button class="cat-btn" onclick="filterCategory('croissant')">Fresh Croissants</button>
                <button class="cat-btn" onclick="filterCategory('sandwich')">Savory Sandwiches</button>
                <button class="cat-btn" onclick="filterCategory('dessert')">Sweets & Desserts</button>
            </div>

            <div id="menu-sections-container"></div>
        </section>
    </div>

    <!-- CHECKOUT PAGE VIEW -->
    <div id="checkout-page" class="page-view animated-fade">
        <div class="checkout-page-container">
            <button class="back-to-store-btn" onclick="switchPage('store')">
                ← Back to Store Menu
            </button>

            <div class="delivery-banner" id="delivery-banner">
                <h2>🎉 Order Placed Successfully!</h2>
                <p>Your order notification has been dispatched automatically to our staff email. We are preparing your order right now.</p>
                <div class="timer-badge">⏱️ Ur order will be delivered in 30 min MAX</div>
                <br>
                <button class="order-again-btn" onclick="resetForNewOrder()">🛒 Place Another Order</button>
            </div>

            <div class="checkout-card" id="checkout-card">
                <h2 class="checkout-title">Review & Complete Order</h2>
                <p style="color: var(--text-muted);">Please review your selected items and provide your delivery information.</p>

                <table class="cart-items-table">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Qty</th>
                            <th>Price</th>
                        </tr>
                    </thead>
                    <tbody id="cart-table-body"></tbody>
                </table>

                <div style="display: flex; justify-content: space-between; font-weight: 700; font-size: 1.25rem; color: var(--primary-dark); margin: 1.5rem 0;">
                    <span>Total Amount:</span>
                    <span id="total-price">0 EGP</span>
                </div>

                <hr style="border: 0; border-top: 1px solid #E0D6CD; margin: 1.5rem 0;">

                <form id="order-form" onsubmit="handleCheckout(event)">
                    <h3 style="font-family: 'Playfair Display', serif; color: var(--primary-dark); margin-bottom: 1rem;">Delivery Information</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" id="cust-name" required placeholder="e.g. Ahmed Hassan">
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input type="tel" id="cust-phone" required placeholder="e.g. 01012345678">
                        </div>
                        <div class="form-group full-width">
                            <label>Delivery Address</label>
                            <textarea id="cust-address" rows="3" required placeholder="Building no, street name, area/neighborhood, city..."></textarea>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="submit-btn">Confirm Order</button>
                </form>
            </div>
        </div>
    </div>

    <!-- SIGN IN / USER PROFILE MODAL -->
    <div class="modal-overlay" id="auth-modal">
        <div class="modal-card">
            <button class="modal-close" onclick="closeAuthModal()">&times;</button>
            <h2 style="font-family: 'Playfair Display', serif; color: var(--primary-dark); margin-bottom: 0.5rem;">Customer Profile</h2>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">Save your information once and order faster next time!</p>

            <form onsubmit="saveCustomerProfile(event)">
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="saved-name" required placeholder="Enter your full name">
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <input type="tel" id="saved-phone" required placeholder="Enter your phone number">
                </div>
                <div class="form-group">
                    <label>Default Address</label>
                    <textarea id="saved-address" rows="3" required placeholder="Enter your default address"></textarea>
                </div>
                <button type="submit" class="submit-btn" style="margin-top:0.5rem;">Save Info</button>
            </form>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast">
        <span>✨ Item added to your cart!</span>
    </div>

    <script>
        // EmailJS Public Key Initializer
        (function() {
            emailjs.init("5cJi2AW6yCpd6RHAa");
        })();

        const catalog = [
