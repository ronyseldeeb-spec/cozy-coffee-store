            { id: 6, name: "Nitro Cold Brew Coffee (Can)", category: "cold", price: 110, desc: "20-hour cold steeped coffee infused with nitrogen for silky creaminess in a can.", images: ["https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=80"], isCan: true },
            { id: 7, name: "Iced Caramel Macchiato (Can)", category: "cold", price: 115, desc: "Cold espresso layered over sweet vanilla milk and buttery caramel drizzle.", images: ["https://images.unsplash.com/photo-1461023058943-07fcbe16d735?auto=format&fit=crop&w=600&q=80"], isCan: true },
            { id: 8, name: "Iced Mocha Latte (Can)", category: "cold", price: 110, desc: "Chilled espresso mixed with Belgian cocoa syrup and milk.", images: ["https://images.unsplash.com/photo-1517701604599-bb29b565090c?auto=format&fit=crop&w=600&q=80"], isCan: true },
            { id: 9, name: "French Pure Butter Croissant", category: "croissant", price: 55, desc: "Golden multi-layered crisp pastry baked daily with premium French butter.", images: ["https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=600&q=80"], isCan: false },
            { id: 10, name: "Nutella Chocolate Croissant", category: "croissant", price: 75, desc: "Flaky croissant filled with rich, warm Nutella hazelnut chocolate cream.", images: ["https://images.unsplash.com/photo-1623334044303-241021148842?auto=format&fit=crop&w=600&q=80"], isCan: false },
