            { id: 12, name: "Smoked Turkey & Cheddar Croissant", category: "sandwich", price: 120, desc: "Fresh croissant filled with smoked turkey breast, melted cheddar cheese, and dijon mustard.", images: ["https://images.unsplash.com/photo-1528735602780-2552fd46c7af?auto=format&fit=crop&w=600&q=80"], isCan: false },
            { id: 13, name: "Classic Caprese Ciabatta", category: "sandwich", price: 110, desc: "Toasted ciabatta bread stuffed with fresh mozzarella, sliced tomatoes, and basil pesto.", images: ["https://images.unsplash.com/photo-1509722747041-616f39b57569?auto=format&fit=crop&w=600&q=80"], isCan: false },
            { id: 14, name: "Salted Caramel Cheesecake", category: "dessert", price: 95, desc: "Creamy New York cheesecake topped with rich homemade salted caramel sauce.", images: ["https://images.unsplash.com/photo-1533134242443-d4fd215305ad?auto=format&fit=crop&w=600&q=80"], isCan: false },
            { id: 15, name: "Warm Chocolate Fudgy Brownie", category: "dessert", price: 70, desc: "Decadent dark chocolate brownie served warm with walnuts.", images: ["https://images.unsplash.com/photo-1606313564200-e75d5e30476c?auto=format&fit=crop&w=600&q=80"], isCan: false }
        ];

        let cart = [];
        let totalOrdersCount = parseInt(localStorage.getItem('cozy_total_orders') || '0');

        const categoryTitles = {
            hot: "☕ Hot Espresso & Brews",
            cold: "🥫 Canned Cold Coffees & Drinks",
            croissant: "🥐 Fresh Artisanal Croissants",
            sandwich: "🥪 Savory Sandwiches & Bites",
            dessert: "🍰 Sweets & Desserts"
        };

        // Initialize Store State
        document.addEventListener('DOMContentLoaded', () => {
            updateOrdersCounterDisplay();
            loadCustomerProfile();
        });

        function updateOrdersCounterDisplay() {
            document.getElementById('store-orders-count').innerText = totalOrdersCount;
        }

        function switchPage(page) {
            document.querySelectorAll('.page-view').forEach(p => p.classList.remove('active'));
            if (page === 'store') {
                document.getElementById('store-page').classList.add('active');
            } else if (page === 'checkout') {
                document.getElementById('checkout-page').classList.add('active');
                renderCheckoutCart();
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderMenu(categoryFilter = 'all') {
            const container = document.getElementById('menu-sections-container');
            container.innerHTML = '';
            const categoriesToRender = categoryFilter === 'all' 
                ? ['hot', 'cold', 'croissant', 'sandwich', 'dessert'] 
                : [categoryFilter];

            categoriesToRender.forEach(cat => {
                const items = catalog.filter(p => p.category === cat);
                if (items.length === 0) return;

                const section = document.createElement('div');
                section.className = 'animated-fade';
                section.innerHTML = `
                    <div class="section-header">
                        <h2 class="section-title">${categoryTitles[cat]}</h2>
                    </div>
                    <div class="product-grid">
                        ${items.map(p => `
                            <div class="product-card">
                                <div class="image-container">
                                    ${p.isCan ? '<span class="badge-can">Nice Can</span>' : ''}
                                    <img src="${p.images[0]}" class="product-img" alt="${p.name}">
                                </div>
                                <div class="product-info">
                                    <h3 class="product-title">${p.name}</h3>
                                    <p class="product-desc">${p.desc}</p>
                                </div>
                                <div class="product-bottom">
                                    <span class="price">${p.price} EGP</span>
                                    <button class="add-btn" onclick="addToCart(${p.id})">+ Add Item</button>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                `;
                container.appendChild(section);
            });
        }

        function filterCategory(cat) {
            document.querySelectorAll('.cat-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
            renderMenu(cat);
        }

        function addToCart(productId) {
            const product = catalog.find(p => p.id === productId);
            const existing = cart.find(item => item.id === productId);

            if (existing) {
                existing.qty++;
            } else {
                cart.push({ ...product, qty: 1 });
            }

            updateCartBadge();
            showToast(`Added ${product.name} to cart!`);
        }

        function changeQty(productId, delta) {
            const item = cart.find(i => i.id === productId);
            if (item) {
                item.qty += delta;
                if (item.qty <= 0) {
                    cart = cart.filter(i => i.id !== productId);
                }
            }
            updateCartBadge();
            renderCheckoutCart();
        }

        function updateCartBadge() {
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            document.getElementById('cart-count').innerText = totalCount;
        }

        function renderCheckoutCart() {
            const tableBody = document.getElementById('cart-table-body');
            const totalPriceElem = document.getElementById('total-price');

            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            totalPriceElem.innerText = `${totalPrice} EGP`;

            if (cart.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="3" style="text-align:center; color: var(--text-muted); padding: 2rem;">Your cart is empty. Return to store to add items!</td></tr>`;
                return;
            }

            tableBody.innerHTML = cart.map(item => `
                <tr>
                    <td><strong>${item.name}</strong></td>
                    <td>
                        <div class="qty-controls">
                            <button class="qty-btn" onclick="changeQty(${item.id}, -1)">-</button>
                            <span>${item.qty}</span>
                            <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
                        </div>
                    </td>
                    <td>${item.price * item.qty} EGP</td>
                </tr>
            `).join('');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.querySelector('span').innerText = msg;
            toast.classList.add('show');
            setTimeout(() => {
                toast.classList.remove('show');
            }, 2500);
        }

        /* --- Customer Profile & Sign-In Functions --- */
        function openAuthModal() {
            document.getElementById('auth-modal').style.display = 'flex';
        }

        function closeAuthModal() {
            document.getElementById('auth-modal').style.display = 'none';
        }

        function saveCustomerProfile(e) {
            e.preventDefault();
            const profile = {
                name: document.getElementById('saved-name').value,
                phone: document.getElementById('saved-phone').value,
                address: document.getElementById('saved-address').value
            };
            localStorage.setItem('cozy_customer_profile', JSON.stringify(profile));
            loadCustomerProfile();
            closeAuthModal();
            showToast("Profile information saved successfully!");
        }

        function loadCustomerProfile() {
            const savedData = localStorage.getItem('cozy_customer_profile');
            if (savedData) {
                const profile = JSON.parse(savedData);
                document.getElementById('cust-name').value = profile.name;
                document.getElementById('cust-phone').value = profile.phone;
                document.getElementById('cust-address').value = profile.address;

                document.getElementById('saved-name').value = profile.name;
                document.getElementById('saved-phone').value = profile.phone;
                document.getElementById('saved-address').value = profile.address;

                document.getElementById('user-profile-btn').innerText = `👤 ${profile.name.split(' ')[0]}`;
            }
        }

        /* --- Checkout & Email Submission --- */
        function handleCheckout(e) {
            e.preventDefault();

            if (cart.length === 0) {
                showToast("⚠️ Your cart is empty!");
                return;
            }

            const submitBtn = document.getElementById('submit-btn');
            submitBtn.innerText = "Sending Order...";
            submitBtn.disabled = true;

            const name = document.getElementById('cust-name').value;
            const phone = document.getElementById('cust-phone').value;
            const address = document.getElementById('cust-address').value;
            
            // Auto save form inputs to profile for convenience
            localStorage.setItem('cozy_customer_profile', JSON.stringify({ name, phone, address }));
            loadCustomerProfile();

            const orderItemsFormatted = cart.map(i => `${i.name} x${i.qty} (${i.price * i.qty} EGP)`).join(', ');
            const totalAmount = document.getElementById('total-price').innerText;

            const templateParams = {
                customer_name: name,
                customer_phone: phone,
                customer_address: address,
                order_details: orderItemsFormatted,
                total_price: totalAmount
            };

            emailjs.send('service_7bbe3hl', 'template_v1jh9xd', templateParams)
                .then((response) => {
                    // Update Order Count
                    totalOrdersCount++;
                    localStorage.setItem('cozy_total_orders', totalOrdersCount.toString());
                    updateOrdersCounterDisplay();

                    document.getElementById('checkout-card').style.display = 'none';
                    document.getElementById('delivery-banner').style.display = 'block';
                    cart = [];
                    updateCartBadge();
                })
                .catch((err) => {
                    console.error('EmailJS Error:', err);
                    alert("EmailJS Error details: " + (err.text || JSON.stringify(err)));
                    submitBtn.innerText = "Confirm Order";
                    submitBtn.disabled = false;
                });
        }

        function resetForNewOrder() {
            document.getElementById('delivery-banner').style.display = 'none';
            document.getElementById('checkout-card').style.display = 'block';
            const submitBtn = document.getElementById('submit-btn');
            submitBtn.innerText = "Confirm Order";
            submitBtn.disabled = false;
            switchPage('store');
        }

        renderMenu();
    </script>
</body>
</html>
